# Backend environment variables.
#
# The API reads its configuration from appsettings.json, which already ships with
# working local defaults, and ASP.NET Core overrides any of those keys from the
# process environment using `__` as the section separator. This file is a
# reference for the names to export (shell, docker-compose, or a hosting panel);
# it is not auto-loaded by `dotnet run`.
#
# Only AccessTokenSecret must be replaced before any non-local use: the value in
# appsettings.json is a placeholder, not a secret.

# Which appsettings.{Environment}.json layers on top. Development also enables
# the Swagger UI at /swagger.
ASPNETCORE_ENVIRONMENT=Development

# URL the API listens on. Must match frontend API_BASE_URL.
ASPNETCORE_URLS=http://localhost:5128

# PostgreSQL connection string.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=assignment_system;Username=postgres;Password=postgres

# JWT signing and token lifetimes. The secret must be at least 32 bytes.
Jwt__Issuer=AssignmentSystem
Jwt__Audience=AssignmentSystemClient
Jwt__AccessTokenSecret=replace_with_a_random_secret_of_at_least_32_bytes
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7
Jwt__RefreshTokenGraceWindowSeconds=30

# BCrypt cost factor for password hashing.
BCrypt__WorkFactor=12
